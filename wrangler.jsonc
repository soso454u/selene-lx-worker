{
  "name": "selene-lx-worker",
  "main": "src/index.js",
  "compatibility_date": "2026-11-08",
  "workers_dev": true,
  "ratelimits": [
    {
      "name": "IP_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 12,
        "period": 60
      }
    },
    {
      "name": "EDGE_LIMIT",
      "namespace_id": "1002",
      "simple": {
        "limit": 40,
        "period": 60
      }
    }
  ]
}
